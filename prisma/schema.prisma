datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./client"
}

enum UserStatus {
  PENDING
  ACTIVE
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  name      String
  role      String     @default("Developer")
  status    UserStatus @default(PENDING)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

enum JobStatus {
  Draft
  Generated
  Sent
  Interviewing
  Declined
}

model JobPost {
  id                 String    @id @default(uuid())
  role               String
  company            String
  originalText       String    @db.Text
  parsedSummary      String    @db.Text
  contactName        String?
  contactEmail       String?
  matchScore         Int
  postedDate         DateTime  @default(now())
  tags               String[]
  status             JobStatus @default(Draft)
  notes              String?   @db.Text
  coldEmail          String?   @db.Text
  proposal           String?   @db.Text
  linkedin           String?   @db.Text
  coverLetter        String?   @db.Text
}

model UserProfile {
  id             String   @id @default("default-profile")
  name           String
  role           String
  email          String
  skills         String[]
  portfolioUrl   String
  githubUrl      String
  linkedinUrl    String
  resumeFileName String?
  education      Json     // Array of { degree, school, year }
  projects       Json     // Array of { name, tech: string[], description }
}

model Skill {
  id        String   @id @default(uuid())
  name      String   @unique
  category  String   @default("General")
  createdAt DateTime @default(now())
}

model EmailOtp {
  id        String   @id @default(uuid())
  email     String
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}
