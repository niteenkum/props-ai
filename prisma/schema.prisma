datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  PENDING
  ACTIVE
}

model User {
  id        String       @id @default(uuid())
  email     String       @unique
  password  String
  name      String
  role      String       @default("Developer")
  status    UserStatus   @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  profile   UserProfile?
  projects  Project[]
}

enum JobStatus {
  Draft
  Generated
  Sent
  Interviewing
  Declined
}

model JobPost {
  id                 String      @id @default(uuid())
  role               String
  company            String
  originalText       String      @db.Text
  parsedSummary      String      @db.Text
  contactName        String?
  contactEmail       String?
  contactPhone       String?                          // extracted from job post text
  matchScore         Int
  postedDate         DateTime    @default(now())
  tags               String[]
  status             JobStatus   @default(Draft)
  notes              String?     @db.Text
  coldEmail          String?     @db.Text
  proposal           String?     @db.Text
  linkedin           String?     @db.Text
  coverLetter        String?     @db.Text
  generatedTemplates Json?                            // flexible map of platformKey → text
  suggestAttachResume Boolean?                        // AI hint: should resume be attached?
  matchExplanation   String?     @db.Text             // AI explanation of candidacy fit
  matchedSkills      String[]                         // skills from profile matching the job
  missingSkills      String[]                         // skills job needs that profile lacks
  sentEmails         SentEmail[]
  followUps          FollowUp[]                       // scheduled calls and reminders
  whatsappSource     WhatsAppMessage?                 // reverse link from WA message
}

model UserProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  role            String
  email           String
  skills          String[]
  portfolioUrl    String
  githubUrl       String
  linkedinUrl     String
  resumeFileName  String?
  resumeText      String?  @db.Text // Raw extracted resume text stored in DB
  resumePdfBase64 String?  @db.Text // base64-encoded PDF binary for email attachment
  education       Json     // Array of { degree, school, year }
}

model Project {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  tech        String[]
  description String   @db.Text
  links       Json?    // Array of { label, url }
}

model Skill {
  id        String   @id @default(uuid())
  name      String   @unique
  category  String   @default("General")
  createdAt DateTime @default(now())
}

model EmailOtp {
  id        String   @id @default(uuid())
  email     String
  otp       String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email])
}

// ─── AI Usage Expense Log ──────────────────────────────────────────────────
// Every Gemini API call is logged here with token counts and computed cost.
model AiUsageLog {
  id              String   @id @default(uuid())
  
  // What triggered this call
  apiType         String   // "pdf_parse" | "job_analysis" | "content_cold_email" | "content_proposal" | "content_linkedin" | "content_cover_letter"
  category        String   // "pdf_reading" | "content_writing" | "formalizing" | "job_analysis"
  model           String   // e.g. "gemini-2.5-flash"
  provider        String   @default("gemini")
  
  // Context
  jobPostId       String?  // if triggered by a job post
  userEmail       String?  // which user triggered it

  // Token metrics (from Gemini usageMetadata)
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  totalTokens     Int      @default(0)
  
  // Cost (USD) — computed using Gemini Flash pricing
  inputCostUsd    Float    @default(0)
  outputCostUsd   Float    @default(0)
  totalCostUsd    Float    @default(0)

  // Response metadata
  durationMs      Int      @default(0)  // latency in milliseconds
  success         Boolean  @default(true)
  errorMessage    String?

  createdAt       DateTime @default(now())

  @@index([apiType])
  @@index([createdAt])
  @@index([userEmail])
}

// ─── Follow-Up Tracker ───────────────────────────────────────────────────
// Tracks all follow-ups for a job: scheduled calls (with Meet links), email
// follow-up reminders, and manual notes. Status lifecycle: pending → done/cancelled.
model FollowUp {
  id            String   @id @default(uuid())
  userEmail     String                          // ThePitchly user
  jobId         String?                         // linked job post (optional for standalone calls)
  jobPost       JobPost?  @relation(fields: [jobId], references: [id], onDelete: SetNull)

  type          String   @default("call")       // "call" | "email" | "manual"
  title         String                          // e.g. "Interview call with Stripe"
  scheduledAt   DateTime                        // when is the call/follow-up due?
  durationMin   Int      @default(30)           // call duration in minutes

  // Google Calendar / Meet (populated after Corsair calendar.events.create)
  gcalEventId   String?                         // Google Calendar event ID
  meetLink      String?                         // meet.google.com/xxx — from hangoutLink
  gcalEventUrl  String?                         // htmlLink to Google Calendar event
  attendeeEmail String?                         // recruiter's email (invited to Meet)

  // Status
  status        String   @default("pending")    // "pending" | "done" | "cancelled" | "rescheduled"
  notes         String?  @db.Text

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userEmail])
  @@index([jobId])
  @@index([scheduledAt])
  @@index([userEmail, status])
}

// ─── Linked Mail Account ─────────────────────────────────────────────
// Stores OAuth tokens for a user's linked mail accounts.
// Supports MULTIPLE accounts per user — one row per (userEmail, provider).
// provider: "zoho" | "gmail" | "googlecalendar"
model MailAccount {
  id              String   @id @default(uuid())
  userEmail       String                          // ThePitchly user email
  provider        String   @default("zoho")       // "zoho" | "gmail"
  accountEmail    String                          // the actual mailbox address linked
  accessToken     String   @db.Text
  refreshToken    String?  @db.Text
  expiresAt       DateTime                        // when the access token expires
  zohoAccountId   String?                         // Zoho internal account ID (zoho only)
  apiBase         String?                         // Region-correct API base (zoho only)
  corsairTenantId String?                         // Corsair tenant ID (gmail only)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userEmail, provider])  // one account per user per provider
  @@index([userEmail])
}

// ─── Sent Email Log ────────────────────────────────────────────────────────
// Tracks every email sent from ThePitchly via any provider (Zoho, later Gmail).
// Linked to a JobPost so the user can see outreach history per opportunity.
model SentEmail {
  id          String    @id @default(uuid())
  userEmail   String                        // ThePitchly user who sent
  jobPostId   String?                       // linked job (nullable for non-job sends)
  jobPost     JobPost?  @relation(fields: [jobPostId], references: [id], onDelete: SetNull)
  provider    String    @default("zoho")    // "zoho" | "gmail" | "outlook"
  fromEmail   String                        // sender mailbox address
  toEmail     String
  subject     String    @db.Text
  body        String    @db.Text
  zohoMsgId   String?                       // message ID returned by Zoho
  sentAt      DateTime  @default(now())

  @@index([userEmail])
  @@index([jobPostId])
}

// ─── WhatsApp Messages Table ────────────────────────────────────────────────────────────
// Stores ALL messages synced from WhatsApp groups — approved, skipped, and rejected.
// Users can see all messages and manually promote skipped/low-score ones to job leads.
model WhatsAppMessage {
  id                 String    @id @default(uuid())
  userEmail          String
  groupId            String
  groupName          String
  whatsappMessageId  String    @unique           // msg.key.id from Baileys — globally unique per WA message
  senderPhone        String    @default("")
  senderName         String    @default("Unknown")
  text               String    @db.Text
  timestamp          DateTime

  // Analysis state
  // raw | skipped | analyzed | duplicate | lead
  status             String    @default("raw")

  // AI candidacy analysis results (populated after Gemini call)
  aiScore            Int?
  aiRole             String?
  aiCompany          String?
  aiExplanation      String?   @db.Text
  matchedSkills      String[]
  missingSkills      String[]

  // Duplicate detection: if this message is a duplicate, link to the original job post
  isDuplicate        Boolean   @default(false)
  duplicateOfJobId   String?   // points to the existing JobPost this duplicates

  // If this message became a job lead, link to the created JobPost
  jobPostId          String?   @unique
  jobPost            JobPost?  @relation(fields: [jobPostId], references: [id], onDelete: SetNull)

  createdAt          DateTime  @default(now())

  @@index([userEmail])
  @@index([groupId])
  @@index([whatsappMessageId])
  @@index([userEmail, groupId])
}

// ─── Corsair SDK Tables (DO NOT MODIFY / DO NOT DROP) ─────────────────────────
// These tables are managed by the Corsair SDK (@corsair-dev/gmail).
// Prisma must not migrate or drop them — they are declared here only to
// prevent `prisma db push` from treating them as unknown tables.
// The actual schema is managed by the Corsair SDK internally.

model CorsairAccount {
  id         String   @id
  tenantId   String   @map("tenant_id")
  plugin     String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("corsair_accounts")
  @@ignore
}

model CorsairIntegration {
  id        String   @id
  accountId String   @map("account_id")
  plugin    String
  config    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("corsair_integrations")
  @@ignore
}

model CorsairEntity {
  id         String   @id
  accountId  String   @map("account_id")
  plugin     String
  entityType String   @map("entity_type")
  data       Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("corsair_entities")
  @@ignore
}

model CorsairEvent {
  id        String   @id
  accountId String   @map("account_id")
  plugin    String
  eventType String   @map("event_type")
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("corsair_events")
  @@ignore
}

// ─── Synced Email Engine ──────────────────────────────────────────────────
// Stores AI-classified incoming emails for fast, incremental offline access.
model SyncedEmail {
  id            String   @id @default(uuid())
  userEmail     String   // ThePitchly user email
  provider      String   // "gmail" | "zoho"
  messageId     String   // provider's message ID (for dedup)
  subject       String   @db.Text
  fromEmail     String
  fromName      String
  receivedAt    DateTime
  summary       String   @db.Text // first ~120 chars
  isRead        Boolean  @default(false)
  
  // AI-powered fields
  emailType     String   // "interview_call" | "freelance_opportunity" | "remote_opportunity" | "rejection" | "offer_letter" | "general"
  aiSummary     String?  @db.Text // 1-sentence summary by Gemini
  sentiment     String?  // "positive" | "neutral" | "negative"
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userEmail, provider, messageId])
  @@index([userEmail])
  @@index([userEmail, receivedAt(sort: Desc)])
  @@index([userEmail, emailType])
}

model EmailSyncCursor {
  id            String   @id @default(uuid())
  userEmail     String
  provider      String   // "gmail" | "zoho"
  lastSyncAt    DateTime // timestamp of last successfully synced email
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userEmail, provider])
}

